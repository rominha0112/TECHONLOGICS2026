# =========================================
# MOVIMENTO RETO COM CORREÇÃO DO IMU
# =========================================

def pid(cm,velocidade = 500):
    motor_esquerdo.reset_angle(0)
    motor_direito.reset_angle(0)
    if cm > 0:
        direcao = 1
    else:
        direcao = -1
    angulo_inicial = int(hub.imu.heading())
    velocidade_base = velocidade * direcao
    graus_alvo = int((cm / CIRCUNFERENCIA_RODA) * 360)


    while min((abs(motor_esquerdo.angle()) , abs(motor_direito.angle())))  < abs(graus_alvo):

            erro =angulo_inicial - hub.imu.heading() 
            if erro > 180:
                erro = erro - 360
            elif erro < -180:
                erro = erro + 360

            correcao = K_LINE * erro
            correcao = correcao * direcao

            esquerda = int(velocidade_base + correcao)
            direita = int(velocidade_base - correcao)

            esquerda = max(-500, min(500, esquerda))
            direita = max(-500, min(500, direita))

            motor_esquerdo.run(esquerda)
            motor_direito.run(direita)

            wait(10)

    motor_esquerdo.stop()
    motor_direito.stop()
# =========================================
# MOVER EM CENTÍMETROS
# =========================================

def mover(cm, velocidade=720):

    graus_de_movimento = int((360 / CIRCUNFERENCIA_RODA) * cm)
    motor_esquerdo.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=False)
    motor_direito.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=True)

def mover2(cm):
    robo.straight(cm *10)

# =========================================
# GIRO
# =========================================

def giro(angulo_alvo):
    cronometro.reset()
    trava_tempo.reset()
    erro_anterior = 0
    derivativo = 0
    erro = 0
    hub.imu.reset_heading(0)
    Kp = angulo_alvo * X_TIME   
    Kd = int((angulo_alvo * X_TIME )/0.8)  
    t = int(angulo_alvo * X_TIME )
    while trava_tempo.time() < t:
        angulo_atual = hub.imu.heading()
        erro = angulo_alvo - angulo_atual
        derivativo = (erro - erro_anterior) 
        erro_anterior = erro
        correcao = int((Kp * erro) + (Kd * derivativo))
        correcao = max(-100, min(200,correcao))
        potencia_esquerda = correcao
        potencia_direita = -correcao
        motor_esquerdo.run(potencia_esquerda)
        motor_direito.run(potencia_direita)
        wait(10)
    motor_esquerdo.stop()
    motor_direito.stop() 
    print('[Relatório de giro]: Rotação concluída e estabilizada em {}°'.format(hub.imu.heading()))  
def giro2(graus):
    robo.turn(graus) 


    
