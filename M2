from pybricks.hubs import PrimeHub
from pybricks.pupdevices import Motor
from pybricks.parameters import Port, Direction,Stop
from pybricks.robotics import DriveBase
from pybricks.tools import wait,StopWatch

hub = PrimeHub()
motor_esquerdo = Motor(Port.C, Direction.COUNTERCLOCKWISE)
motor_direito = Motor(Port.D)
garra1 = Motor(Port.E)
garra2 = Motor(Port.A)
cronometro = StopWatch()
trava_tempo = StopWatch() 

RODA_DIAMETRO = 5.1
DISTANCIA_EIXOS = 12
CIRCUNFERENCIA_RODA = 16.022

KD = 0.670
KP = 6.70

K_LINE = 1.5
    
robo = DriveBase(
    garra2,
    garra1,
    RODA_DIAMETRO,
    DISTANCIA_EIXOS
)

# =========================================
# GARRA 1
# =========================================

def mover_garra1G(graus, velocidade):
    velocidade = max(-1000, min(1000, int(velocidade * 10)))


    garra1.run_angle(
        velocidade,
        int(graus * 2.49),
        then=Stop.HOLD
    )


# =========================================
# GARRA 2
# =========================================

def mover_garra2P(graus, velocidade):
    velocidade = max(-1000, min(1000, int(velocidade * 10)))

    garra2.run_angle(
        velocidade,
        int(graus * 2.49),
        then=Stop.HOLD
    )


# =========================================
# MOVIMENTO RETO COM CORREÇÃO DO IMU
# =========================================

def pid(cm,velocidade = 500):
    motor_esquerdo.reset_angle(0)
    motor_direito.reset_angle(0)
    if cm > 0:
        direcao = 1
    else:
        direcao = -1
    angulo_inicial = int(hub.imu.heading())
    velocidade_base = velocidade * direcao
    graus_alvo = int((cm / CIRCUNFERENCIA_RODA) * 360)


    while min((abs(motor_esquerdo.angle()) , abs(motor_direito.angle())))  < abs(graus_alvo):

            erro =angulo_inicial - hub.imu.heading() 
            if erro > 180:
                erro = erro - 360
            elif erro < -180:
                erro = erro + 360

            correcao = K_LINE * erro
            correcao = correcao * direcao

            esquerda = int(velocidade_base + correcao)
            direita = int(velocidade_base - correcao)

            esquerda = max(-500, min(500, esquerda))
            direita = max(-500, min(500, direita))

            motor_esquerdo.run(esquerda)
            motor_direito.run(direita)

            wait(10)

    motor_esquerdo.stop()
    motor_direito.stop()
# =========================================
# MOVER EM CENTÍMETROS
# =========================================

def mover(cm, velocidade=720):

    graus_de_movimento = int((360 / CIRCUNFERENCIA_RODA) * cm)
    motor_esquerdo.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=False)
    motor_direito.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=True)

def mover2(cm):
    robo.straight(cm *10)

# =========================================
# GIRO
# =========================================

def giro(angulo_alvo):#sempre somar 0.3 ao angulo alvo
    cronometro.reset()
    trava_tempo.reset()
    erro_anterior = 0
    derivativo = 0
    erro = 0

    hub.imu.reset_heading(0)
    while True:
        angulo_atual = hub.imu.heading()
        erro = angulo_alvo - angulo_atual
        if abs(erro) < 0.5 or trava_tempo.time() > 1000:
            break
        dt = cronometro.time() / 1000.0
        if dt == 0:
            dt = 0.0001
        cronometro.reset()
        derivativo = (erro - erro_anterior) /dt 
        erro_anterior = erro
        correcao = (KP * erro) + (KD * derivativo)
        correcao = max(-100, min(100,correcao))
        potencia_esquerda = correcao
        potencia_direita = -correcao
        motor_esquerdo.dc(potencia_esquerda)
        motor_direito.dc(potencia_direita)
        wait(10)
    motor_esquerdo.stop()
    motor_direito.stop() 
    print('[MUNDO FÍSICO]: Rotação concluída e estabilizada em {}°'.format(hub.imu.heading()))  
def giro2(graus):
    robo.turn(graus) 

