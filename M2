import motor_pair
import runloop
import motor
from hub import port, motion_sensor


PAR_MOTORES = motor_pair.PAIR_1
MOTOR_ESQUERDO = port.C
MOTOR_DIREITO = port.D
motor_pair.pair(PAR_MOTORES, MOTOR_ESQUERDO, MOTOR_DIREITO)

#-----------------------------------------

async def mover_garra1G(graus, velocidade):
    motor.reset_relative_position(port.E, 0)
    vel_final = int(velocidade * 10)
    await motor.run_for_degrees(
        port.E,
        int(graus * 2.49),
        vel_final
    )

async def mover_garra2P(graus, velocidade):
    motor.reset_relative_position(port.A, 0)
    vel_final = max(-1000, min(1000, int(velocidade * 10)))
    await motor.run_for_degrees(
        port.A,
        int(graus * 2.49 ),
        vel_final
    )

#-----------------------------------------

async def pid(cm,vb):
    motor.reset_relative_position(port.D, 0)
    motor.reset_relative_position(port.C, 0)
    angulo_atual = motion_sensor.tilt_angles()[0]
    cm =int(cm * 20)
    erro = 0 - angulo_atual
    correcao = 0.001 * erro
    velocidade_base = vb
    esquerda = int(velocidade_base - correcao)
    direita = int(velocidade_base + correcao)
    esquerda = max(-1000, min(1000, esquerda))
    direita = max(-1000, min(1000, direita))

    await motor_pair.move_tank_for_degrees(
        motor_pair.PAIR_1,
        int(cm),
        esquerda,
        direita
    )

#-----------------------------------------

async def mover(cm, velocidade=500):
    circunferencia = 16.014
    cm_distancia = int((cm / circunferencia) * 360)
    vel_deg_s = max(-1000, min(1000, int(velocidade * 10)))

    await motor_pair.move_for_degrees(
        motor_pair.PAIR_1,
        cm_distancia,
        0,
        velocity=vel_deg_s
    )
    motor_pair.stop(motor_pair.PAIR_1, stop=motor.BRAKE)

#-----------------------------------------

async def giro(angulo_alvo,vel):
    # Reseta o sensor de guinada (Yaw) para garantir leitura limpa
    motion_sensor.reset_yaw(0)
    await runloop.sleep_ms(500) # Estabilização do sensor
    await runloop.sleep_ms(500)

    # Define velocidades seguras para giro (300 deg/s)
    if angulo_alvo > 0:
        vel_esq, vel_dir = vel, -vel
    else:
        vel_esq, vel_dir = -vel, vel
    # Multiplicador do giroscópio do SPIKE v3 geralmente é 10 para décimos de grau
    alvo_decimos = abs(angulo_alvo * 10)

    # Laço unificado: lê o valor absoluto atual e compara com o alvo absoluto
    while abs(motion_sensor.tilt_angles()[0]) < alvo_decimos:
        motor_pair.move_tank(motor_pair.PAIR_1, vel_esq, vel_dir)
        await runloop.sleep_ms(10)

    motor_pair.stop(motor_pair.PAIR_1, stop=motor.BRAKE)

#-----------------------------------------

async def main():
    await mover_garra2P(-130,25)
    await mover_garra1G(130,25)
    await pid (84,600)
    await giro (-20,250)
    await pid (7, 500)
    await giro (-40, 300)
    await giro(35,500)
    await pid(-14,400)
    await giro(-50,200)
    await mover(-10,100)
    await pid(45,600)
    await giro(-25,100)
    await pid(8,300)
    await giro(-35,100)
    await pid(5,300)
    await giro(-11,250)
    await mover(-9.5,100)
    await mover_garra1G(130,50)
    await giro(1,50)
    await mover(2,50)
    await mover_garra1G(-40,5)
    await giro(10,10)
    await mover(-3)
    await giro(80,100)
    await pid(29,400)
    await giro(-90,100)
    await pid(-45,500)
    await giro(-40,100)
    await mover(-13,10)
    await mover(15.5,50)
    await giro(80,50)
    await mover_garra1G(100,110)
    await mover(3,50)
runloop.run(main())
