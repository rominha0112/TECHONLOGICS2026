def mover(cm, velocidade=720):

    graus_de_movimento = int((360 / CIRCUNFERENCIA_RODA) * cm)
    motor_esquerdo.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=False)
    motor_direito.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=True)

    
def esperar(segundos):
    wait(int(segundos * 1000))



# GIRO AJUSTADO COM KP = ANGULO ATUAL E AJUSTE MATEMÁTICO PERFEITO
# =========================================
# =========================================
# GIRO AJUSTADO COM ANÁLISE DINÂMICA DE ERRO
# =========================================
# =========================================
# GIRO AJUSTADO COM SOMA DE ERRO CONTÍNUA ATÉ O ALVO
# =========================================
def giro(angulo_alvo, velocidade_maxima=720):
    cronometro.reset()
    trava_tempo.reset()
    erro_anterior = 0
    
    hub.imu.reset_heading(0)
    esperar(0.1)
    
    KD = 0.5
    
    # 1. LOOP PRINCIPAL (Giro rápido até chegar perto)
    while True:
        angulo_atual = hub.imu.heading()
        erro = angulo_alvo - angulo_atual
        
        if erro > 180:
            erro -= 360
        elif erro < -180:
            erro += 360
            
        # Quando chegar a menos de 1.5 graus do alvo, sai do loop rápido
        if abs(erro) < 1.5 or trava_tempo.time() > 1500:
            break
            
        dt = cronometro.time() / 1000.0
        if dt == 0:
            dt = 0.0001
        cronometro.reset()
        
        derivativo = (erro - erro_anterior) / dt
        erro_anterior = erro
        
        kp_dinamico = abs(angulo_atual) * 0.1 + 2.0
        correcao = (kp_dinamico * erro) + (KD * derivativo)
        correcao = max(-velocidade_maxima, min(velocidade_maxima, correcao))
        
        motor_esquerdo.run(correcao)
        motor_direito.run(-correcao)
        
        wait(10)
        
    motor_esquerdo.stop()
    motor_direito.stop()
    wait(50) # Pausa rápida para estabilizar a leitura do sensor
    
    # 2. SEGUNDO LOOP: AJUSTE ATIVO (Soma o erro ao ângulo atual dinamicamente)
    # Este loop continuará corrigindo até que a soma dê exatamente o ângulo alvo
    cronometro_ajuste = StopWatch()
    
    while True:
        angulo_atual = hub.imu.heading()
        erro = angulo_alvo - angulo_atual
        
        # A lógica da soma que você sugeriu:
        # Se somarmos o ângulo atual com o erro, precisamos chegar ao angulo_alvo.
        # Se o erro for menor que 0.15 graus, consideramos o erro zerado.
        if abs(erro) < 0.15 or cronometro_ajuste.time() > 1000:
            break
            
        # Força ultra baixa e controlada para não passar do ponto por causa da inércia
        # Multiplicamos o erro por um ganho de precisão (ex: 7) para gerar velocidade
        velocidade_ajuste = erro * 7.5
        
        # Garante uma velocidade mínima para o robô vencer o atrito do chão, mas sem correr demais
        if velocidade_ajuste > 0:
            velocidade_ajuste = max(15, min(60, velocidade_ajuste))
        else:
            velocidade_ajuste = min(-15, max(-60, velocidade_ajuste))
            
        # Aplica o movimento sutil nas rodas
        motor_esquerdo.run(velocidade_ajuste)
        motor_direito.run(-velocidade_ajuste)
        
        wait(5)
        
    # Trava final absoluta
    motor_esquerdo.stop()
    motor_direito.stop()
    
    angulo_final_real = hub.imu.heading()
    print('[MUNDO FÍSICO]: Giro finalizado.')
    print('Ângulo Atual: {}° + Erro Remanescente: {}° = Total: {}°'.format(
        angulo_final_real, 
        (angulo_alvo - angulo_final_real), 
        angulo_final_real + (angulo_alvo - angulo_final_real)
    ))



   


