        velocidade,
        int(graus * 2.49),
        then=Stop.HOLD
    )


# =========================================
# MOVIMENTO RETO COM CORREÇÃO DO IMU
# =========================================

def pid(cm,velocidade = 500):

    if cm > 0:
        direcao = 1
    else:
        direcao = -1
    angulo_inicial = int(hub.imu.heading())
    velocidade_base = velocidade * direcao
    graus_alvo = int((cm / CIRCUNFERENCIA_RODA) * 360)


    while min((abs(motor_esquerdo.angle()) , abs(motor_direito.angle())))  < abs(graus_alvo):

            erro = angulo_inicial - int(hub.imu.heading()) 
            if erro > 180:
                erro = erro - 360
            elif erro < -180:
                erro = erro + 360

            correcao = K_LINE * erro
            correcao = correcao * direcao

            esquerda = int(velocidade_base - correcao)
            direita = int(velocidade_base + correcao)

            esquerda = max(-500, min(500, esquerda))
            direita = max(-500, min(500, direita))
            
            motor_esquerdo.run(esquerda)
            motor_direito.run(direita)
            erro = angulo_inicial - int(hub.imu.heading())
            esquerda = esquerda - erro *2 
            direita = direita + erro  
            motor_esquerdo.run(esquerda/2)
            motor_direito.run(direita/2)
            



            wait(10)

    motor_esquerdo.stop()
    motor_direito.stop()
# =========================================
# MOVER EM CENTÍMETROS
# =========================================

def mover(cm, velocidade=1000):

    graus_de_movimento = int((360 / CIRCUNFERENCIA_RODA) * cm)
    motor_esquerdo.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=False)
    motor_direito.run_angle(velocidade,graus_de_movimento,then=Stop.HOLD,wait=True)

def mover2(cm):
    robo.straight(cm *10)

# =========================================
# GIRO
# =========================================



    
    


def giro(angulo_alvo, velocidade_maxima=190):
    trava_tempo = StopWatch()
    cronometro = StopWatch()
    trava_tempo.reset()
    cronometro.reset()
    
    erro_anterior = 0

    hub.imu.reset_heading(0)
    esperar(0.3)

    

    KD = angulo_alvo /20

    while True:

        angulo_atual = hub.imu.heading()

        erro = angulo_alvo - angulo_atual

        
        if erro > 180:
           erro -= 360

        elif erro < -180:
            erro += 360

       
        if trava_tempo.time() >= 1200 or abs(erro) < 1:
            break

        dt = cronometro.time() / 1000.0

        if dt == 0:
            dt = 0.0001

        cronometro.reset()

        derivativo = (erro - erro_anterior) / dt

        erro_anterior = erro

        KD=3.5
        KP=1.2

        correcao = (KP * erro) + (KD * derivativo)

        
        correcao = max(
            -velocidade_maxima,
            min(velocidade_maxima, correcao)
        )

        motor_esquerdo.run(-correcao)
        motor_direito.run(correcao)

        wait(10)

    motor_esquerdo.stop()
    motor_direito.stop()

    wait(50)

    

    cronometro_ajuste = StopWatch()

    esperar(0.5)

    angulo_final_real = hub.imu.heading()

    print('[MUNDO FÍSICO]: Giro finalizado.')

    print(
        'Ângulo Atual: {}° + Erro Remanescente: {}° = Total: {}°'.format(
            angulo_final_real,
            angulo_alvo - angulo_final_real,
            angulo_final_real + (angulo_alvo - angulo_final_real)
        )
    )

def giro2(graus):
